server {
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # This creates a virtual JSON endpoint that Angular will call
    location /api/config {
        default_type application/json;
        return 200 '{"firebaseConfig": $FIREBASE_CONFIG, "backendUrl": "$BACKEND_URL"}';
    }

    # Standard Angular routing support
    location / {
        try_files $uri $uri/ /index.html;
    }
}